{
  "name": "reconstruccion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "arq": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "verificar": "pnpm lint && pnpm typecheck && pnpm arq && pnpm test",
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
